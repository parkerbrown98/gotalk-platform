---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Load eagerly with high priority. Use for the one image above the fold. */
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  priority = false,
  sizes = '(min-width: 1240px) 1192px, calc(100vw - 48px)',
  class: className,
} = Astro.props;
---

<div class:list={['screenshot', className]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[480, 800, 1200, 1600, 2400]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</div>

<style>
  .screenshot {
    border-radius: 12px;
    overflow: hidden;
    background: var(--gt-color-canvas);
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.8);
  }

  .screenshot :global(img) {
    width: 100%;
    height: auto;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found · Gotalk" description="This page doesn’t exist." noindex>
  <section class="section">
    <div class="container prose-column">
      <p class="eyebrow">404</p>
      <h1 class="title">We couldn’t find that page</h1>
      <p class="lede">It may have moved, or the link may be mistyped.</p>
      <div class="actions">
        <a class="button button-primary" href="/">
          Go to the home page
        </a>
        <a class="button button-secondary" href="/features">
          See features
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

{
  "name": "@gotalk-platform/index-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JSON Schemas, fixtures and request signing for the Gotalk public index protocol",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schemas",
    "fixtures"
  ],
  "scripts": {
    "check": "node scripts/check-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
